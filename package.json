{
  "name": "mac-shortcut-map",
  "private": true,
  "type": "module",
  "description": "Renders a keyboard shortcut map into an overview page, a key-combination lookup and a printable cheat sheet.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "prettier --check . && eslint . && node scripts/module-diagram.js --check && node --test",
    "format": "prettier --write .",
    "test": "node --test",
    "diagram": "node scripts/module-diagram.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  }
}
